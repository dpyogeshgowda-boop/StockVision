<file path="frontend/src/services/api.js">
import axios from "axios";

const API = axios.create({
    baseURL: "http://127.0.0.1:8000",
});

export const getMarketSummary = async () => {
    const response = await API.get("/market-summary");
    return response.data;
};

export const getMarketData = async () => {
    const response = await API.get("/market-data?limit=250");
    return response.data;
};

export const getTechnicalIndicators = async () => {
    const response = await API.get("/technical-indicators");
    return response.data;
};

export default API;
</file>

<file path="frontend/src/App.css">
* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: "Segoe UI", sans-serif;
  background: #0b1120;
  color: #e5e7eb;
}

.app-container {
  display: flex;
  min-height: 100vh;
}

.sidebar {
  width: 250px;
  min-width: 250px;
  background: #111827;
  padding: 30px 20px;
  display: flex;
  flex-direction: column;
  border-right: 1px solid #273449;
  position: sticky;
  top: 0;
  height: 100vh;
}

.logo {
  display: flex;
  align-items: center;
  gap: 12px;
  color: #38bdf8;
  margin-bottom: 45px;
}

.logo h2 {
  color: white;
  font-size: 21px;
}

.menu-label {
  font-size: 11px;
  color: #718096;
  letter-spacing: 2px;
  margin-bottom: 18px;
}

nav {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

nav a {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 13px;
  border-radius: 8px;
  color: #9ca3af;
  cursor: pointer;
  transition: 0.2s;
  text-decoration: none;
  font-size: 15px;
}

nav a:hover,
nav a.active {
  background: #1e3a5f;
  color: #38bdf8;
}

.sidebar-bottom {
  margin-top: auto;
  display: flex;
  gap: 12px;
  color: #9ca3af;
  padding: 15px 5px;
}

.main-content {
  flex: 1;
  padding: 35px;
  min-width: 0;
  max-width: 1600px;
  margin: auto;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}

.topbar h1 {
  margin-bottom: 5px;
  font-size: 42px;
}

.topbar p,
.section-heading p {
  color: #94a3b8;
  margin-top: 5px;
}

.top-actions {
  display: flex;
  align-items: center;
  gap: 23px;
}

.profile {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: #2563eb;
  display: grid;
  place-items: center;
}

.market-selector {
  display: flex;
  justify-content: space-between;
  align-items: end;
  margin-top: 35px;
  padding: 25px;
  background: #111c30;
  border-radius: 12px;
  gap: 15px;
}

.market-selector label {
  display: block;
  color: #94a3b8;
  font-size: 11px;
  margin-bottom: 10px;
}

select {
  background: #1e293b;
  color: white;
  border: 1px solid #334155;
  padding: 11px 15px;
  border-radius: 7px;
  cursor: pointer;
}

select:disabled {
  opacity: 1;
  cursor: not-allowed;
}

.market-status {
  color: #94a3b8;
  font-size: 13px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.status-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  background: #22c55e;
  border-radius: 50%;
}

.refresh-button {
  display: grid;
  place-items: center;
  background: transparent;
  color: #38bdf8;
  border: none;
  cursor: pointer;
  padding: 8px;
}

.refresh-button:disabled {
  opacity: 0.4;
  cursor: wait;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
  margin-top: 25px;
}

.stat-card,
.analysis-card {
  background: #111c30;
  border: 1px solid #273449;
  border-radius: 12px;
  padding: 22px;
}

.stat-card p {
  color: #94a3b8;
  font-size: 13px;
}

.stat-card h2 {
  font-size: 25px;
  margin: 15px 0 8px;
  color: #38bdf8;
  overflow-wrap: anywhere;
}

.stat-card span {
  color: #94a3b8;
  font-size: 12px;
}

.chart-section {
  background: #111c30;
  border: 1px solid #273449;
  padding: 25px;
  margin-top: 25px;
  border-radius: 12px;
  scroll-margin-top: 20px;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
}

.section-heading h2 {
  margin-top: 0;
}

.chart-controls {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
  margin: 22px 0;
}

.chart-controls label {
  color: #cbd5e1;
  font-size: 13px;
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
}

.chart-controls input {
  accent-color: #38bdf8;
  cursor: pointer;
}

.chart-container {
  width: 100%;
  height: 380px;
  margin-top: 15px;
}

.loading-box {
  height: 280px;
  display: grid;
  place-items: center;
  color: #38bdf8;
}

.indicator-note {
  color: #94a3b8;
  font-size: 12px;
  margin-top: 20px;
}

.bottom-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-top: 25px;
  scroll-margin-top: 20px;
}

.analysis-card svg {
  color: #38bdf8;
}

.analysis-card p {
  color: #94a3b8;
  line-height: 1.6;
}

.model-tag {
  display: inline-block;
  background: #123b32;
  color: #4ade80;
  padding: 7px 12px;
  border-radius: 20px;
  font-size: 12px;
}

.coming-soon {
  font-size: 12px;
  color: #facc15 !important;
}

.error-box {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 15px;
  margin-top: 20px;
  background: #451a1a;
  border: 1px solid #7f1d1d;
  color: #fca5a5;
  border-radius: 8px;
  flex-wrap: wrap;
}

.error-box button {
  margin-left: auto;
  padding: 8px 14px;
  border: none;
  border-radius: 6px;
  background: #b91c1c;
  color: white;
  cursor: pointer;
}

footer {
  text-align: center;
  color: #64748b;
  padding: 35px 0 10px;
}

@media (max-width: 1100px) {

  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .sidebar {
    width: 210px;
    min-width: 210px;
  }

}

@media (max-width: 700px) {

  .sidebar {
    display: none;
  }

  .main-content {
    padding: 18px;
  }

  .topbar h1 {
    font-size: 29px;
  }

  .stats-grid,
  .bottom-grid {
    grid-template-columns: 1fr;
  }

  .market-selector {
    align-items: flex-start;
    flex-direction: column;
  }

  .section-heading {
    align-items: flex-start;
    flex-direction: column;
  }

}
/* LSTM PREDICTION BUTTON */

.predict-button {
    width: 100%;
    padding: 13px;
    margin-top: 15px;
    border: none;
    border-radius: 8px;
    background: #2563eb;
    color: white;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: 0.3s;
}

.predict-button:hover {
    background: #1d4ed8;
}

.predict-button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}


/* LSTM PREDICTION RESULTS */

.prediction-results {
    margin-top: 20px;
    padding: 15px;
    background: #0b1628;
    border-radius: 10px;
    text-align: left;
}

.prediction-results h3 {
    margin-bottom: 15px;
}

.prediction-value {
    margin: 15px 0;
}

.prediction-value span {
    color: #94a3b8;
    font-size: 13px;
}

.prediction-value h2 {
    margin-top: 5px;
    font-size: 25px;
}

.prediction-results p {
    margin: 8px 0;
    color: #cbd5e1;
}

.prediction-results small {
    display: block;
    margin-top: 15px;
    color: #94a3b8;
    line-height: 1.5;
}
.market-selector select {
    min-width: 280px;
    padding: 12px;
    background-color: #1e293b;
    color: #ffffff;
    border: 1px solid #334155;
    border-radius: 8px;
    font-size: 14px;
    cursor: pointer;
}

.market-selector select option {
    background-color: #1e293b;
    color: #ffffff;
}
/* =================================
   STOCKVISION LAYOUT IMPROVEMENTS
================================= */

/* Give LSTM and GARCH separate full-width rows */
.bottom-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 30px;
    width: 100%;
    align-items: start;
}

/* Prevent cards from becoming too narrow */
.bottom-grid > .analysis-card {
    width: 100%;
    min-width: 0;
    padding: 30px;
    box-sizing: border-box;
}

/* Improve prediction results spacing */
.prediction-results {
    width: 100%;
    margin-top: 25px;
    box-sizing: border-box;
}

/* Arrange prediction metric cards in two columns */
.prediction-results .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin: 25px 0;
}

/* Prevent text and numbers from overflowing */
.prediction-results .stat-card {
    min-width: 0;
    padding: 22px;
    overflow-wrap: break-word;
}

.prediction-results .stat-card h2 {
    font-size: 25px;
    line-height: 1.4;
    word-break: normal;
}

/* Give charts sufficient space */
.prediction-results .recharts-responsive-container {
    min-width: 0;
}

/* Improve spacing between result sections */
.prediction-results h3 {
    margin-top: 25px;
    margin-bottom: 18px;
}

.prediction-results p {
    line-height: 1.7;
    margin-bottom: 12px;
}

/* Mobile responsiveness */
@media (max-width: 650px) {
    .bottom-grid {
        grid-template-columns: minmax(0, 1fr);
    }

    .prediction-results .stats-grid {
        grid-template-columns: 1fr;
    }

    .bottom-grid > .analysis-card {
        padding: 18px;
    }
}

@app.get("/market-data")
def market_data(
    symbol: str = "NIFTY50",
    limit: int = 250
):

    try:

        df = get_historical_data(symbol.upper())

        df = df.tail(min(max(limit, 1), 2000)).copy()

        df["Date"] = df["Date"].dt.strftime("%Y-%m-%d")

        df = df.astype(object).where(
            pd.notna(df),
            None
        )

        return {
            "symbol": symbol.upper(),
            "total_records": len(df),
            "data": df.to_dict(orient="records")
        }

    except (ValueError, FileNotFoundError) as e:

        raise HTTPException(
            status_code=404,
            detail=str(e)
        )

    except Exception as e:

        raise HTTPException(
            status_code=500,
            detail=str(e)
        )


# -----------------------------------------
# TECHNICAL INDICATOR CALCULATION
# -----------------------------------------

def calculate_indicators(df):

    df = df.copy()

    # Simple Moving Average
    df["SMA_20"] = df["Close"].rolling(
        window=20
    ).mean()

    df["SMA_50"] = df["Close"].rolling(
        window=50
    ).mean()

    # RSI Calculation
    delta = df["Close"].diff()

    gain = delta.clip(lower=0)

    loss = -delta.clip(upper=0)

    avg_gain = gain.rolling(14).mean()

    avg_loss = loss.rolling(14).mean()

    rs = avg_gain / avg_loss.replace(0, np.nan)

    df["RSI_14"] = 100 - (
        100 / (1 + rs)
    )

    # Bollinger Bands
    rolling_mean = df["Close"].rolling(20).mean()

    rolling_std = df["Close"].rolling(20).std()

    df["Upper_Band"] = (
        rolling_mean + (2 * rolling_std)
    )

    df["Lower_Band"] = (
        rolling_mean - (2 * rolling_std)
    )

    return df


# -----------------------------------------
# API 4: TECHNICAL INDICATORS
# -----------------------------------------

@app.get("/technical-indicators")
def technical_indicators(symbol: str = "NIFTY50"):

    try:

        df = get_historical_data(symbol.upper())

        df = calculate_indicators(df)

        columns = [
            "Date",
            "Close",
            "SMA_20",
            "SMA_50",
            "RSI_14",
            "Upper_Band",
            "Lower_Band"
        ]

        df = df[columns].tail(250).copy()

        df["Date"] = df["Date"].dt.strftime("%Y-%m-%d")

        df = df.astype(object).where(
            pd.notna(df),
            None
        )

        return {
            "symbol": symbol.upper(),
            "indicators": df.to_dict(
                orient="records"
            )
        }

    except (ValueError, FileNotFoundError) as e:

